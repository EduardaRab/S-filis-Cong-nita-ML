# ---------------------------------------------------------------
# Dados: nenhum arquivo de dados vai para o Git.
# As pastas ficam versionadas pelos .gitkeep e pelo data/README.md.
# ---------------------------------------------------------------
data/raw/*
data/processed/*
data/outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep

# Dados brutos ou derivados soltos em qualquer outra pasta
*.csv
*.dbc
*.dbf
*.parquet
*.feather
*.pkl
*.joblib

# Documentos com dados pessoais (planos de trabalho com CPF, RG, endereço, telefone)
*.pdf

# Ambiente Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# Power BI: o .pbip e as pastas *.SemanticModel/ e *.Report/ são versionados;
# o cache de dados e as configurações locais não
*.pbix
**/.pbi/cache.abf
**/.pbi/localSettings.json

# IDE
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Configuração local / segredos
.env
